# MailMind — Environment Configuration Template
# Copy this file to .env and fill in real values before running the application.
# Never commit .env to version control.

# Email address of the bot Gmail account
GMAIL_ADDRESS=your-bot@gmail.com

# 16-character Gmail App Password (not the account password).
# Generate at: https://myaccount.google.com/apppasswords
# Requires 2FA to be enabled on the bot account.
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Groq API key from https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Minimum meeting duration in minutes (integer).
# A slot shorter than this value is not eligible for proposal.
MEETING_DURATION_MINUTES=60

# How often (in seconds) the bot polls the inbox for new messages (integer).
POLL_INTERVAL_SECONDS=30

# IANA timezone string used as fallback when a participant has no stored timezone.
# Examples: Asia/Kolkata, America/New_York, Europe/London, UTC
DEFAULT_TIMEZONE=UTC
